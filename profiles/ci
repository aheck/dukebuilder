include(default)

[settings]
build_type=Release
{% if platform.system() == "Linux" %}
# Qt's source build requires libstdc++'s __int128 support, disabled in strict C++ mode.
compiler.cppstd=gnu17
{% else %}
compiler.cppstd=17
{% endif %}
{% if platform.system() == "Windows" %}
compiler.runtime=dynamic
compiler.runtime_type=Release
{% endif %}

[options]
# macOS currently requires shared Qt (no static Cocoa plugin integration).
qt/*:shared=True

[conf]
tools.build:jobs=4
{% if platform.system() == "Windows" %}
tools.env.virtualenv:powershell=pwsh
{% endif %}
tools.system.package_manager:mode=install
{% if platform.system() == "Linux" %}
tools.system.package_manager:sudo=True
{% endif %}
