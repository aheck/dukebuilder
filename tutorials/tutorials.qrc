<RCC>
  <qresource prefix="/tutorials">
    <file alias="tror-stacked-rooms/index.html">tror-stacked-rooms/index.html</file>
    <!-- Add each tutorial page and its images here, using aliases that keep
         the tutorial's folder structure inside the resource path. -->
    <file alias="vertical-doors/index.html">vertical-doors/index.html</file>
    <file alias="vertical-doors/images/layout.png">vertical-doors/images/layout.png</file>
    <file alias="vertical-doors/images/door-sector-select.jpg">vertical-doors/images/door-sector-select.jpg</file>
    <file alias="vertical-doors/images/door-texture.jpg">vertical-doors/images/door-texture.jpg</file>
    <file alias="vertical-doors/images/sector-effector-properties.png">vertical-doors/images/sector-effector-properties.png</file>
    <file alias="vertical-doors/images/sprites.png">vertical-doors/images/sprites.png</file>
  </qresource>
</RCC>
